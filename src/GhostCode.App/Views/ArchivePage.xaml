<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GhostCode.App.Views.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GhostCode.App.ViewModels">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search & Filter Bar -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                PlaceholderText="{x:Bind ViewModel.Strings.ArchiveSearchPlaceholder, Mode=OneWay}"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="SearchBox_KeyDown" />

            <ComboBox
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.PlatformFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedPlatformFilter, Mode=TwoWay}" />

            <Button
                Grid.Column="2"
                Content="Search"
                Style="{ThemeResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.SearchArchiveCommand}" />
        </Grid>

        <!-- Master-Detail Archive Browser -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ListView
                    ItemsSource="{x:Bind ViewModel.ArchiveVersions}"
                    SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArchiveVersionRow">
                            <StackPanel Padding="4,8" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind VersionBadge}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ProblemSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind TimestampText}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ShortSha}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="{x:Bind ViewModel.Strings.CopyCodeButton, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CopySelectedCodeCommand}" />
                        <Button
                            Content="{x:Bind ViewModel.Strings.RestoreVersionButton, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="RestoreVersion_Click" />
                        <Button
                            Content="{x:Bind ViewModel.Strings.OpenArchiveButton, Mode=OneWay}"
                            Command="{x:Bind ViewModel.OpenArchiveFolderCommand}" />
                        <Button
                            Content="{x:Bind ViewModel.Strings.OpenReadyButton, Mode=OneWay}"
                            Command="{x:Bind ViewModel.OpenReadyFolderCommand}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Text="{x:Bind ViewModel.SelectedVersion.SourcePath, Mode=OneWay, FallbackValue=''}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />

                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="12">
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedVersionSource, Mode=OneWay}"
                            FontFamily="Cascadia Code, Consolas, Courier New"
                            FontSize="13"
                            IsTextSelectionEnabled="True"
                            TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
