<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GhostCode.App.Views.ArchivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GhostCode.App.ViewModels">

    <Grid Padding="20,12,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search & Filters Header -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="165" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                PlaceholderText="{x:Bind ViewModel.Strings.ArchiveSearchPlaceholder, Mode=OneWay}"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="SearchBox_KeyDown" />

            <ComboBox
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.PlatformFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedPlatformFilter, Mode=TwoWay}" />

            <ComboBox
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.AvailabilityFilterLabels, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.SelectedAvailabilityFilterIndex, Mode=TwoWay}" />

            <Button
                Grid.Column="3"
                Content="{x:Bind ViewModel.UxStrings.SearchButton, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.SearchArchiveCommand}" />

            <Button
                Grid.Column="4"
                Content="{x:Bind ViewModel.Strings.PullCloudButton, Mode=OneWay}"
                Command="{x:Bind ViewModel.PullCloudArchiveCommand}" />
        </Grid>

        <!-- 3-Pane Workspace: File Explorer | Source + Version Viewer | Console & Split I/O Runner -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="220" />
                <ColumnDefinition Width="1.2*" MinWidth="300" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Pane 1: File Explorer -->
            <Border
                x:Name="ExplorerPane"
                Grid.Column="0"
                Padding="8"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <ListView
                    x:Name="FileExplorerListView"
                    ItemsSource="{x:Bind ViewModel.ArchiveFileGroups}"
                    SelectedItem="{x:Bind ViewModel.SelectedFileGroup, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArchiveFileGroupRow">
                            <StackPanel Padding="4,8" Spacing="3">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="6,2" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind LatestVersionBadge}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Pane 2: Read-Only Versioned Source Code Viewer -->
            <Border
                x:Name="SourceViewerPane"
                Grid.Column="1"
                Padding="14"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Version Selector & Action Toolbar -->
                    <StackPanel Grid.Row="0" Spacing="6">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            Header="{x:Bind ViewModel.Strings.VersionSelectorLabel, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.SelectedFileVersions}"
                            SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}"
                            DisplayMemberPath="SelectorLabel" />

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SplitButton
                                Padding="8,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.Strings.CopyCodeButton, Mode=OneWay}"
                                Command="{x:Bind ViewModel.CopySelectedCodeCommand}">
                                <SplitButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ExpStrings.CopyLatestCode, Mode=OneWay}" Command="{x:Bind ViewModel.CopyLatestProblemCodeCommand}" />
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ExpStrings.CopySourcePath, Mode=OneWay}" Command="{x:Bind ViewModel.CopySourcePathCommand}" />
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ExpStrings.CopyProblemUrl, Mode=OneWay}" Command="{x:Bind ViewModel.CopyProblemUrlCommand}" />
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ExpStrings.CopySampleInput, Mode=OneWay}" Command="{x:Bind ViewModel.CopySampleInputCommand}" />
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ExpStrings.CopySampleOutput, Mode=OneWay}" Command="{x:Bind ViewModel.CopySampleOutputCommand}" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                            <SplitButton
                                Padding="8,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.ExpStrings.OpenInIde, Mode=OneWay}"
                                Command="{x:Bind ViewModel.OpenInIdeCommand}">
                                <SplitButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ExpStrings.OpenWorkingCopyInIde, Mode=OneWay}" Command="{x:Bind ViewModel.OpenInIdeCommand}" />
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.UxStrings.OpenOriginalSourceMenu, Mode=OneWay}" Command="{x:Bind ViewModel.OpenOriginalInIdeCommand}" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                            <Button
                                Padding="8,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.ExpStrings.CompareDiffButton, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleDiffModeCommand}" />
                            <Button
                                Padding="8,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.Strings.RestoreVersionButton, Mode=OneWay}"
                                Click="RestoreVersion_Click" />
                            <Button
                                Padding="8,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.Strings.DownloadVersionButton, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SelectedVersionIsCloudOnly, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DownloadSelectedVersionCommand}" />
                            <Button
                                x:Name="RunSourceButton"
                                Padding="8,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.Strings.RunCodeButton, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RunCodeCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Version Integrity Header -->
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedVersionHeaderText, Mode=OneWay}"
                            FontWeight="SemiBold"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ViewModel.SelectedVersion.SourcePath, Mode=OneWay, FallbackValue=''}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Cloud-Only Banner -->
                    <InfoBar
                        Grid.Row="2"
                        IsOpen="{x:Bind ViewModel.SelectedVersionIsCloudOnly, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Informational"
                        Message="{x:Bind ViewModel.Strings.CloudOnlyNotice, Mode=OneWay}" />

                    <!-- Read-Only Source Viewer -->
                    <TextBox
                        x:Name="SourceCodeViewerBox"
                        Grid.Row="3"
                        Visibility="{x:Bind ViewModel.SourceViewerVisibility, Mode=OneWay}"
                        Text="{x:Bind ViewModel.SelectedVersionSource, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.Strings.NoVersionSelected, Mode=OneWay}"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        FontSize="13"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <!-- Non-Destructive Version Diff Viewer -->
                    <Grid
                        x:Name="VersionDiffViewer"
                        Grid.Row="3"
                        Visibility="{x:Bind ViewModel.DiffModeVisibility, Mode=OneWay}"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Header="{x:Bind ViewModel.UxStrings.CompareBaselineLabel, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.SelectedFileVersions}"
                                SelectedItem="{x:Bind ViewModel.CompareWithVersion, Mode=TwoWay}"
                                DisplayMemberPath="SelectorLabel" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Content="{x:Bind ViewModel.UxStrings.DiffStyleToggleLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleDiffStyleCommand}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,6"
                                Text="{x:Bind ViewModel.DiffSummaryText, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="SemiBold" />
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            Visibility="{x:Bind ViewModel.DiffSideBySideVisibility, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.DiffSideBySideLines}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiffLineRow">
                                    <Grid ColumnSpacing="6" Padding="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind KindTag}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind LeftNumText}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind LeftText}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind RightNumText}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind RightText}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBox
                            Grid.Row="1"
                            Visibility="{x:Bind ViewModel.DiffUnifiedVisibility, Mode=OneWay}"
                            Text="{x:Bind ViewModel.DiffUnifiedText, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            FontFamily="Consolas"
                            FontSize="12"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Pane 3: Console & Split STDIN/OUTPUT Execution Panel -->
            <Border
                x:Name="RunnerPane"
                Grid.Column="2"
                Padding="14"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tab & Execution Action Bar -->
                    <StackPanel Grid.Row="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="ConsoleTabBtn"
                                Padding="10,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.Strings.RunnerTabConsole, Mode=OneWay}"
                                Click="ConsoleTab_Click" />
                            <Button
                                x:Name="IoTabBtn"
                                Padding="10,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.Strings.RunnerTabIo, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="IoTab_Click" />
                            <Button
                                x:Name="SamplesTabBtn"
                                Padding="10,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.ExpStrings.SamplesTabLabel, Mode=OneWay}"
                                Click="SamplesTab_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="PanelRunButton"
                                Padding="10,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.Strings.RunCodeButton, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RunCodeCommand}" />
                            <Button
                                x:Name="PanelStopButton"
                                Padding="10,4"
                                FontSize="12"
                                Content="{x:Bind ViewModel.Strings.StopRunButton, Mode=OneWay}"
                                Command="{x:Bind ViewModel.StopExecutionCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status & Metrics Strip -->
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="8,3" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <TextBlock x:Name="RunnerStatusLabel" Text="{x:Bind ViewModel.RunnerStatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            x:Name="RunnerMetricsLabel"
                            Text="{x:Bind ViewModel.RunnerMetricsText, Mode=OneWay}"
                            FontSize="11"
                            FontFamily="Consolas"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="{x:Bind ViewModel.Strings.ClearConsoleButton, Mode=OneWay}" Command="{x:Bind ViewModel.ClearConsoleCommand}" />
                    </Grid>

                    <!-- View A: Console Output -->
                    <TextBox
                        x:Name="ConsoleOutputBox"
                        Grid.Row="2"
                        Visibility="{x:Bind ViewModel.ConsoleTabVisibility, Mode=OneWay}"
                        Text="{x:Bind ViewModel.ConsoleLogText, Mode=OneWay}"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        FontSize="12"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <!-- View B: Vertically Split STDIN (Top) & OUTPUT (Bottom) with Draggable Splitter -->
                    <Grid
                        x:Name="IoSplitContainer"
                        Grid.Row="2"
                        Visibility="{x:Bind ViewModel.IoTabVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="StdinRowDef" Height="*" MinHeight="80" />
                            <RowDefinition Height="10" />
                            <RowDefinition x:Name="OutputRowDef" Height="1.3*" MinHeight="90" />
                        </Grid.RowDefinitions>

                        <!-- Top: STDIN -->
                        <Grid Grid.Row="0" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Text="{x:Bind ViewModel.Strings.StdinHeader, Mode=OneWay}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox
                                x:Name="StdinInputBox"
                                Grid.Row="1"
                                Text="{x:Bind ViewModel.StdinText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{x:Bind ViewModel.Strings.StdinPlaceholder, Mode=OneWay}"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                FontFamily="Consolas"
                                FontSize="12"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>

                        <!-- Draggable Vertical Splitter -->
                        <Border
                            x:Name="IoSplitterThumb"
                            Grid.Row="1"
                            Background="Transparent"
                            ManipulationMode="TranslateY"
                            ManipulationDelta="IoSplitter_ManipulationDelta">
                            <Border
                                Height="4"
                                Width="56"
                                CornerRadius="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        </Border>

                        <!-- Bottom: OUTPUT -->
                        <Grid Grid.Row="2" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Text="{x:Bind ViewModel.Strings.OutputHeader, Mode=OneWay}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox
                                x:Name="IoOutputBox"
                                Grid.Row="1"
                                Text="{x:Bind ViewModel.IoOutputText, Mode=OneWay}"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                FontFamily="Consolas"
                                FontSize="12"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>

                    <!-- View C: Problem Statement, Judge Verdict & Sample Test Runner -->
                    <Grid
                        x:Name="SamplesPanel"
                        Grid.Row="2"
                        RowSpacing="8"
                        Visibility="{x:Bind ViewModel.SamplesTabVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Problem Statement & Judge Verdict Card -->
                        <Border Grid.Row="0" Padding="8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.UxStrings.ProblemVerdictTitle, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Grid.Column="1" Padding="6,2" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.LatestVerdictBadgeText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.CurrentProblemStatementSummary, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.TimelineSummaryText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveCodingTimeText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Sample Selector & Actions -->
                        <StackPanel Grid.Row="1" Spacing="6">
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                PlaceholderText="{x:Bind ViewModel.UxStrings.NoSampleCasesPlaceholder, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.SampleTests}"
                                SelectedItem="{x:Bind ViewModel.SelectedSampleTest, Mode=TwoWay}"
                                DisplayMemberPath="DisplayLabel" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Padding="8,4" FontSize="11" Content="{x:Bind ViewModel.ExpStrings.RunSampleButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.RunSelectedSampleCommand}" />
                                <Button Padding="8,4" FontSize="11" Content="{x:Bind ViewModel.ExpStrings.RunAllSamplesButton, Mode=OneWay}" Command="{x:Bind ViewModel.RunAllSamplesCommand}" />
                                <Button Padding="8,4" FontSize="11" Content="{x:Bind ViewModel.ExpStrings.AddCustomTestButton, Mode=OneWay}" Click="AddCustomSample_Click" />
                                <Button Padding="8,4" FontSize="11" Content="{x:Bind ViewModel.UxStrings.DeleteSampleShort, Mode=OneWay}" Command="{x:Bind ViewModel.DeleteSelectedSampleCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Input / Expected Preview -->
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Header="{x:Bind ViewModel.UxStrings.SampleInputHeader, Mode=OneWay}" Text="{x:Bind ViewModel.SelectedSampleInputPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" Height="92" />
                            <TextBox Grid.Column="1" Header="{x:Bind ViewModel.UxStrings.SampleExpectedHeader, Mode=OneWay}" Text="{x:Bind ViewModel.SelectedSampleExpectedPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" Height="92" />
                        </Grid>

                        <!-- Comparison Summary & Expected vs Actual Diff -->
                        <Grid Grid.Row="3" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.SampleRunSummaryText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                            <TextBox
                                Grid.Row="1"
                                Text="{x:Bind ViewModel.SampleComparisonDiffText, Mode=OneWay}"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                FontFamily="Consolas"
                                FontSize="11"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
