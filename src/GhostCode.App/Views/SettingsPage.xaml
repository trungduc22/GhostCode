<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GhostCode.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:GhostCode.App.ViewModels">

    <ScrollViewer
        x:Name="SettingsScrollViewer"
        Padding="24,16,24,24"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="SettingsRootPanel"
            Spacing="18"
            MaxWidth="1040"
            HorizontalAlignment="Stretch">

            <!-- 1. General & Appearance + Paths -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Strings.SettingsGeneralTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.LanguageLabel, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}" MinWidth="180">
                        <ComboBoxItem Content="Tiếng Việt" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.ThemeLabel, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.ThemeChoices, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                        MinWidth="180" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.MinimizeToTrayLabel, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <ToggleSwitch
                        MinWidth="0"
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}"
                        OnContent=""
                        OffContent="" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.AutoCopyReadyLabel, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <ToggleSwitch
                        MinWidth="0"
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.AutoCopyReadyPath, Mode=TwoWay}"
                        OnContent=""
                        OffContent="" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.ArchiveDirLabel, Mode=OneWay}" Description="{x:Bind ViewModel.ArchiveDir, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <Button Content="{x:Bind ViewModel.Strings.BrowseButton, Mode=OneWay}" Click="BrowseArchiveDir_Click" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.ReadyDirLabel, Mode=OneWay}" Description="{x:Bind ViewModel.ReadyDir, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <Button Content="{x:Bind ViewModel.Strings.BrowseButton, Mode=OneWay}" Click="BrowseReadyDir_Click" />
                </controls:SettingsCard>
            </StackPanel>

            <!-- 2. Monitored Folders (No nested ListView - stretches smoothly) -->
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Strings.SettingsFoldersTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Bind ViewModel.Strings.AddFolderButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Click="AddFolder_Click" />
                </Grid>

                <Border
                    Padding="14"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.NoFoldersVisible, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <TextBlock Text="{x:Bind ViewModel.Strings.EmptyFoldersMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </Border>

                <ItemsControl x:Name="MonitoredFoldersItems" ItemsSource="{x:Bind ViewModel.WatchedFolders}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WatchedFolderItem">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Path}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Width="48"
                                        HorizontalAlignment="Center"
                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                        OnContent=""
                                        OffContent=""
                                        VerticalAlignment="Center" />
                                    <CheckBox
                                        Grid.Column="2"
                                        MinWidth="0"
                                        IsChecked="{x:Bind IsRecursive, Mode=TwoWay}"
                                        Content="{x:Bind RecursiveLabel, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="3"
                                        Tag="{x:Bind}"
                                        Click="RemoveFolder_Click"
                                        VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 3. Diagnostics & Configuration Export (Browsers, IDEs & Compilers live in Development Tools; Cloud Sync lives in Drive) -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Strings.SettingsAdvancedTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.BridgeTokenLabel, Mode=OneWay}" Description="{x:Bind ViewModel.BridgeInfoText, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <Button Content="{x:Bind ViewModel.Strings.ExportConfigButton, Mode=OneWay}" Click="ExportConfig_Click" />
                </controls:SettingsCard>
            </StackPanel>

            <!-- 8. Productivity Hotkey, Appearance (Mica), Notifications & Privacy Opt-In -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.UxStrings.SettingsProductivityTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsHotkeyHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.GlobalHotkeyStatusText, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="140" Text="{x:Bind ViewModel.GlobalHotkeyGesture, Mode=TwoWay}" PlaceholderText="Ctrl+Shift+F9" />
                        <ToggleSwitch MinWidth="0" HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.GlobalHotkeyEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsMicaHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsMicaDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ComboBox
                        x:Name="MicaAppearanceCombo"
                        ItemsSource="{x:Bind ViewModel.MicaChoices, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedMicaKindIndex, Mode=TwoWay}"
                        MinWidth="180" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.AccentColorHeaderText, Mode=OneWay}"
                    Description="{x:Bind ViewModel.AccentColorDescText, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            Width="16"
                            Height="16"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            Background="{ThemeResource GhostAccentBrush}" />
                        <ComboBox
                            x:Name="AccentPresetCombo"
                            ItemsSource="{x:Bind ViewModel.AccentPresetChoices, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedAccentPresetIndex, Mode=TwoWay}"
                            MinWidth="180" />
                        <TextBox
                            Width="96"
                            PlaceholderText="#2563EB"
                            Visibility="{x:Bind ViewModel.CustomAccentVisibility, Mode=OneWay}"
                            Text="{x:Bind ViewModel.CustomAccentHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsNotifHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsNotifDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.NotificationLevelChoices, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedNotificationLevelIndex, Mode=TwoWay}"
                        MinWidth="180" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.NotificationDurationHeaderText, Mode=OneWay}"
                    Description="{x:Bind ViewModel.NotificationDurationDescText, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ComboBox
                        x:Name="NotificationDurationCombo"
                        ItemsSource="{x:Bind ViewModel.NotificationDurationChoices, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedNotificationDurationIndex, Mode=TwoWay}"
                        MinWidth="180" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsStmtCaptureHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsStmtCaptureDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ToggleSwitch MinWidth="0" HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.CaptureProblemStatements, Mode=TwoWay}" OnContent="" OffContent="" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsVerdictHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsVerdictDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ToggleSwitch MinWidth="0" HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.TrackSubmissionVerdicts, Mode=TwoWay}" OnContent="" OffContent="" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsTrimWsHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsTrimWsDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ToggleSwitch MinWidth="0" HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.TrimTrailingWhitespaceOnCompare, Mode=TwoWay}" OnContent="" OffContent="" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsCodingTimeHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsCodingTimeDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ToggleSwitch MinWidth="0" HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.EstimateActiveCodingTime, Mode=TwoWay}" OnContent="" OffContent="" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsAiHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.CopilotStatusText, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ToggleSwitch MinWidth="0" HorizontalAlignment="Right" IsOn="{x:Bind ViewModel.AiAssistanceOptIn, Mode=TwoWay}" OnContent="" OffContent="" />
                </controls:SettingsCard>

                <!-- Relocated Compact Diagnostics & Monitor Event Log Expander -->
                <Expander
                    Header="{x:Bind ViewModel.UxStrings.LastDiagnosticResultLabel, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10" Padding="4">
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.UxStrings.LastDetectedFileLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LastDetectedFileText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.UxStrings.LastSuccessfulBackupLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LastSuccessfulBackupText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.UxStrings.LastMonitoringErrorLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LastMonitoringErrorText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.UxStrings.LastDiagnosticResultLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.LastDiagnosticResultText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.Strings.DiagnosticButton, Mode=OneWay}" Command="{x:Bind ViewModel.RunDiagnosticCommand}" />
                            <Button Content="{x:Bind ViewModel.ExpStrings.RunRecoveryCheckButton, Mode=OneWay}" Command="{x:Bind ViewModel.RunRecoveryCheckCommand}" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.RecentEvents}" SelectionMode="None" MaxHeight="180">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonitorEventRow">
                                    <Grid ColumnSpacing="8" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Header}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
