<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GhostCode.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:GhostCode.App.ViewModels">

    <ScrollViewer
        x:Name="SettingsScrollViewer"
        Padding="24,16,24,24"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="SettingsRootPanel"
            Spacing="18"
            MaxWidth="1040"
            HorizontalAlignment="Stretch">

            <!-- 1. General & Appearance + Paths -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Strings.SettingsGeneralTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.LanguageLabel, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}" MinWidth="180">
                        <ComboBoxItem Content="Tiếng Việt" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.ThemeLabel, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.ThemeChoices, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                        MinWidth="180" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.MinimizeToTrayLabel, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <ToggleSwitch
                        IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}"
                        OnContent="{x:Bind ViewModel.Strings.EnabledToggle, Mode=OneWay}"
                        OffContent="{x:Bind ViewModel.UxStrings.DisabledToggle, Mode=OneWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.AutoCopyReadyLabel, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <ToggleSwitch
                        IsOn="{x:Bind ViewModel.AutoCopyReadyPath, Mode=TwoWay}"
                        OnContent="{x:Bind ViewModel.Strings.EnabledToggle, Mode=OneWay}"
                        OffContent="{x:Bind ViewModel.UxStrings.DisabledToggle, Mode=OneWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.ArchiveDirLabel, Mode=OneWay}" Description="{x:Bind ViewModel.ArchiveDir, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <Button Content="{x:Bind ViewModel.Strings.BrowseButton, Mode=OneWay}" Click="BrowseArchiveDir_Click" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.ReadyDirLabel, Mode=OneWay}" Description="{x:Bind ViewModel.ReadyDir, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <Button Content="{x:Bind ViewModel.Strings.BrowseButton, Mode=OneWay}" Click="BrowseReadyDir_Click" />
                </controls:SettingsCard>
            </StackPanel>

            <!-- 2. Monitored Folders (No nested ListView - stretches smoothly) -->
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Strings.SettingsFoldersTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Bind ViewModel.Strings.AddFolderButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Click="AddFolder_Click" />
                </Grid>

                <Border
                    Padding="14"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.NoFoldersVisible, Mode=OneWay}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <TextBlock Text="{x:Bind ViewModel.Strings.EmptyFoldersMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </Border>

                <ItemsControl x:Name="MonitoredFoldersItems" ItemsSource="{x:Bind ViewModel.WatchedFolders}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WatchedFolderItem">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Path}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        MinWidth="0"
                                        IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                        OnContent="{x:Bind Label}"
                                        OffContent="{x:Bind Label}"
                                        VerticalAlignment="Center" />
                                    <CheckBox
                                        Grid.Column="2"
                                        MinWidth="0"
                                        IsChecked="{x:Bind IsRecursive, Mode=TwoWay}"
                                        Content="{x:Bind Label}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="3"
                                        Tag="{x:Bind}"
                                        Click="RemoveFolder_Click"
                                        VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 3. Browsers & Extensions -->
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Strings.SettingsBrowsersTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Bind ViewModel.Strings.RefreshDiscoveryButton, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshDiscoveryCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{x:Bind ViewModel.BrowserStatuses}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BrowserStatusRow">
                            <Border
                                Margin="0,0,0,6"
                                Padding="12"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind DetailText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="8,3" CornerRadius="6" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind StateBadge}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <Button
                                        Grid.Column="2"
                                        Content="{x:Bind ActionButtonLabel}"
                                        Tag="{x:Bind KindKey}"
                                        Click="PrepareBrowser_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 4. Diagnostics & Configuration Export (IDE/Compilers live in Development Tools; Cloud Sync lives in Drive) -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.Strings.SettingsAdvancedTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.BridgeTokenLabel, Mode=OneWay}" Description="{x:Bind ViewModel.BridgeInfoText, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <Button Content="{x:Bind ViewModel.Strings.ExportConfigButton, Mode=OneWay}" Click="ExportConfig_Click" />
                </controls:SettingsCard>
            </StackPanel>

            <!-- 8. Productivity Hotkey, Appearance (Mica), Notifications & Privacy Opt-In -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.UxStrings.SettingsProductivityTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsHotkeyHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.GlobalHotkeyStatusText, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="150" Text="{x:Bind ViewModel.GlobalHotkeyGesture, Mode=TwoWay}" PlaceholderText="Ctrl+Shift+F9" />
                        <ToggleSwitch IsOn="{x:Bind ViewModel.GlobalHotkeyEnabled, Mode=TwoWay}" OnContent="{x:Bind ViewModel.UxStrings.EnabledShortToggle, Mode=OneWay}" OffContent="{x:Bind ViewModel.UxStrings.DisabledToggle, Mode=OneWay}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsMicaHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsMicaDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ComboBox
                        x:Name="MicaAppearanceCombo"
                        ItemsSource="{x:Bind ViewModel.MicaChoices, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedMicaKindIndex, Mode=TwoWay}"
                        MinWidth="180" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsNotifHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsNotifDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.NotificationLevelChoices, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedNotificationLevelIndex, Mode=TwoWay}"
                        MinWidth="180" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsStmtCaptureHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsStmtCaptureDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CaptureProblemStatements, Mode=TwoWay}" OnContent="{x:Bind ViewModel.UxStrings.EnabledShortToggle, Mode=OneWay}" OffContent="{x:Bind ViewModel.UxStrings.DisabledToggle, Mode=OneWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsVerdictHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsVerdictDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.TrackSubmissionVerdicts, Mode=TwoWay}" OnContent="{x:Bind ViewModel.UxStrings.EnabledShortToggle, Mode=OneWay}" OffContent="{x:Bind ViewModel.UxStrings.DisabledToggle, Mode=OneWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsTrimWsHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsTrimWsDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.TrimTrailingWhitespaceOnCompare, Mode=TwoWay}" OnContent="{x:Bind ViewModel.UxStrings.TrimLabel, Mode=OneWay}" OffContent="{x:Bind ViewModel.UxStrings.ExactLabel, Mode=OneWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsCodingTimeHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.UxStrings.SettingsCodingTimeDesc, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.EstimateActiveCodingTime, Mode=TwoWay}" OnContent="{x:Bind ViewModel.UxStrings.EstimatedLabel, Mode=OneWay}" OffContent="{x:Bind ViewModel.UxStrings.DisabledToggle, Mode=OneWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.SettingsAiHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.CopilotStatusText, Mode=OneWay}"
                    HorizontalAlignment="Stretch">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AiAssistanceOptIn, Mode=TwoWay}" OnContent="{x:Bind ViewModel.UxStrings.OptedInLabel, Mode=OneWay}" OffContent="{x:Bind ViewModel.UxStrings.DisabledLabel, Mode=OneWay}" />
                </controls:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
