<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GhostCode.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:GhostCode.App.ViewModels">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="20" MaxWidth="960">

            <!-- Watched Directories Section -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Strings.SettingsFoldersTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Bind ViewModel.Strings.AddFolderButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Click="AddFolder_Click" />
                </Grid>

                <ListView ItemsSource="{x:Bind ViewModel.WatchedFolders}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:WatchedFolderItem">
                            <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Path}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="1" OnContent="Enabled" OffContent="Paused" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" MinWidth="110" />
                                    <ToggleSwitch Grid.Column="2" OnContent="Recursive" OffContent="Top-Only" IsOn="{x:Bind IsRecursive, Mode=TwoWay}" MinWidth="120" />
                                    <Button Grid.Column="3" Content="Remove" Tag="{x:Bind}" Click="RemoveFolder_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Output Paths Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Strings.SettingsPathsTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.Strings.ArchiveDirLabel, Mode=OneWay}"
                    Description="{x:Bind ViewModel.ArchiveDir, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button Content="{x:Bind ViewModel.Strings.BrowseButton, Mode=OneWay}" Click="BrowseArchiveDir_Click" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.Strings.ReadyDirLabel, Mode=OneWay}"
                    Description="{x:Bind ViewModel.ReadyDir, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button Content="{x:Bind ViewModel.Strings.BrowseButton, Mode=OneWay}" Click="BrowseReadyDir_Click" />
                </controls:SettingsCard>
            </StackPanel>

            <!-- General UI & Behavior Settings -->
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Strings.SettingsGeneralTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.LanguageLabel, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF2B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}" Width="180">
                        <ComboBoxItem Content="Tiếng Việt" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.ThemeLabel, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" Width="180">
                        <ComboBoxItem Content="System (Default)" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Light" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.MinimizeToTrayLabel, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE944;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="{x:Bind ViewModel.Strings.AutoCopyReadyLabel, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AutoCopyReadyPath, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="{x:Bind ViewModel.Strings.BridgeTokenLabel, Mode=OneWay}"
                    Description="{x:Bind ViewModel.BridgeInfoText, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button Content="{x:Bind ViewModel.Strings.ExportConfigButton, Mode=OneWay}" Click="ExportConfig_Click" />
                </controls:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
