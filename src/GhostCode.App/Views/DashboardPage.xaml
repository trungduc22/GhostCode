<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GhostCode.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:GhostCode.App.ViewModels">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="1040">

            <!-- Active Problem Card -->
            <controls:SettingsCard
                Header="{x:Bind ViewModel.Strings.ActiveContextTitle, Mode=OneWay}"
                Description="{x:Bind ViewModel.Strings.OpenBrowserHint, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border
                        Padding="10,4"
                        CornerRadius="6"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock
                            Text="{x:Bind ViewModel.ActivePlatform, Mode=OneWay}"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            FontWeight="SemiBold"
                            FontSize="12" />
                    </Border>
                    <TextBlock
                        Text="{x:Bind ViewModel.ActiveCode, Mode=OneWay}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ActiveTitle, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                        MaxWidth="280"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </controls:SettingsCard>

            <!-- Summary Metrics Grid -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Strings.TotalVersionsLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.TotalVersions, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Strings.PendingUploadsLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.PendingUploads, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Strings.SyncedUploadsLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.SyncedUploads, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Strings.FailedUploadsLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.FailedUploads, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Running IDEs & Browsers + Actions -->
            <controls:SettingsCard
                Header="{x:Bind ViewModel.Strings.RunningIdesTitle, Mode=OneWay}"
                Description="{x:Bind ViewModel.BrowserStatusSummary, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE943;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.IdeStatusSummary, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="{x:Bind ViewModel.Strings.DiagnosticButton, Mode=OneWay}" Command="{x:Bind ViewModel.RunDiagnosticCommand}" />
                    <Button Content="{x:Bind ViewModel.Strings.SyncNowButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SyncNowCommand}" />
                </StackPanel>
            </controls:SettingsCard>

            <!-- Quick Open Directories -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="{x:Bind ViewModel.Strings.OpenArchiveButton, Mode=OneWay}" Command="{x:Bind ViewModel.OpenArchiveFolderCommand}" />
                <Button Content="{x:Bind ViewModel.Strings.OpenReadyButton, Mode=OneWay}" Command="{x:Bind ViewModel.OpenReadyFolderCommand}" />
                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshAllCommand}" />
            </StackPanel>

            <!-- Watched Folders & Recent Events Side-by-Side -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.Strings.ActiveWatchesTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                        <ListView ItemsSource="{x:Bind ViewModel.ActiveWatches}" SelectionMode="None" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActiveWatchRow">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind FolderPath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind StatusText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.Strings.RecentEventsTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                        <ListView ItemsSource="{x:Bind ViewModel.RecentEvents}" SelectionMode="None" MaxHeight="260">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MonitorEventRow">
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind Header}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
