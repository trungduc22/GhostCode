<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GhostCode.App.Views.CloudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:GhostCode.App.ViewModels">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact 3-Option Cloud Provider Selector -->
        <controls:SettingsCard
            Grid.Row="0"
            Header="{x:Bind ViewModel.ExpStrings.CloudProviderTitle, Mode=OneWay}"
            Description="{x:Bind ViewModel.UxStrings.DriveProviderDesc, Mode=OneWay}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE895;" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox
                x:Name="PrimaryProviderCombo"
                Width="220"
                ItemsSource="{x:Bind ViewModel.CloudProviderChoices, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.SelectedCloudProviderIndex, Mode=TwoWay}" />
        </controls:SettingsCard>

        <!-- Progressive Disclosure: Active Provider Card Only -->
        <StackPanel Grid.Row="1" Spacing="10">
            <!-- State 1: Local Only ("Không sử dụng") -->
            <Border
                x:Name="LocalOnlyCloudCard"
                Visibility="{x:Bind ViewModel.LocalOnlyCloudCardVisibility, Mode=OneWay}"
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.UxStrings.DriveLocalOnlyTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.UxStrings.DriveLocalOnlyBody, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- State 2: Google Drive Selected -->
            <StackPanel x:Name="GoogleDriveCard" Visibility="{x:Bind ViewModel.GoogleDriveCardVisibility, Mode=OneWay}" Spacing="8">
                <controls:SettingsCard
                    Header="{x:Bind ViewModel.Strings.CloudAccountTitle, Mode=OneWay}"
                    Description="{x:Bind ViewModel.DriveConnectionStatusText, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE753;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind ViewModel.Strings.ConnectGoogleButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConnectGoogleCommand}" />
                        <Button Content="{x:Bind ViewModel.Strings.DisconnectGoogleButton, Mode=OneWay}" Command="{x:Bind ViewModel.DisconnectGoogleCommand}" />
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Google Drive API Disabled Actionable Recovery Banner -->
                <Border
                    x:Name="DriveApiDisabledBanner"
                    Visibility="{x:Bind ViewModel.DriveApiDisabledBannerVisibility, Mode=OneWay}"
                    Padding="12,10"
                    CornerRadius="8"
                    Background="#26FFB900"
                    BorderBrush="#C87E00"
                    BorderThickness="1">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="18" Foreground="#C87E00" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.DriveApiDisabledTitleText, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.CloudSyncStatusDetailText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="{x:Bind ViewModel.DriveApiEnableButtonText, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Padding="10,5" FontSize="12" Command="{x:Bind ViewModel.OpenDriveApiConsoleCommand}" />
                            <Button Content="{x:Bind ViewModel.DriveRetrySyncButtonText, Mode=OneWay}" Padding="10,5" FontSize="12" Command="{x:Bind ViewModel.SyncNowCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active OAuth Progress Strip (Hidden When Connected or Idle) -->
                <Border
                    Visibility="{x:Bind ViewModel.OAuthStageVisibility, Mode=OneWay}"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsOAuthInProgress, Mode=OneWay}" Width="18" Height="18" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OAuthStageText, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" />
                        <Button Grid.Column="2" Content="{x:Bind ViewModel.UxStrings.DriveCancelAuthButton, Mode=OneWay}" Command="{x:Bind ViewModel.CancelOAuthCommand}" />
                    </Grid>
                </Border>

                <Expander Header="{x:Bind ViewModel.UxStrings.DriveAdvancedTitle, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" Padding="0,4,0,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Strings.ConflictPolicyLabel, Mode=OneWay}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.ConflictPolicyChoices, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedConflictPolicyIndex, Mode=TwoWay}" MinWidth="240" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.Strings.ConfigureOAuthButton, Mode=OneWay}" Click="ConfigureOAuth_Click" />
                            <Button Content="{x:Bind ViewModel.UxStrings.MigrateGoogleToOneDrive, Mode=OneWay}" Click="MigrateToOneDriveConfirm_Click" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- State 3: Microsoft OneDrive Selected -->
            <StackPanel x:Name="OneDriveCard" Visibility="{x:Bind ViewModel.OneDriveCardVisibility, Mode=OneWay}" Spacing="8">
                <controls:SettingsCard
                    Header="{x:Bind ViewModel.UxStrings.OneDriveHeader, Mode=OneWay}"
                    Description="{x:Bind ViewModel.OneDriveConnectionStatusText, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE753;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind ViewModel.UxStrings.OneDriveConnectButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConnectOneDriveCommand}" />
                        <Button Content="{x:Bind ViewModel.UxStrings.OneDriveDisconnectButton, Mode=OneWay}" Command="{x:Bind ViewModel.DisconnectOneDriveCommand}" />
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Active OAuth Progress Strip -->
                <Border
                    Visibility="{x:Bind ViewModel.OAuthStageVisibility, Mode=OneWay}"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsOAuthInProgress, Mode=OneWay}" Width="18" Height="18" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OAuthStageText, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" />
                        <Button Grid.Column="2" Content="{x:Bind ViewModel.UxStrings.DriveCancelAuthButton, Mode=OneWay}" Command="{x:Bind ViewModel.CancelOAuthCommand}" />
                    </Grid>
                </Border>

                <Expander Header="{x:Bind ViewModel.UxStrings.DriveAdvancedTitle, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" Padding="0,4,0,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Strings.ConflictPolicyLabel, Mode=OneWay}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.ConflictPolicyChoices, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedConflictPolicyIndex, Mode=TwoWay}" MinWidth="240" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.UxStrings.OneDriveConfigButton, Mode=OneWay}" Click="ConfigureOneDriveOAuth_Click" />
                            <Button Content="{x:Bind ViewModel.UxStrings.MigrateOneDriveToGoogle, Mode=OneWay}" Click="MigrateToGoogleDriveConfirm_Click" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>

        <!-- Compact Bidirectional Sync Strip (Hidden in Local-Only Mode) -->
        <Border
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.ActiveCloudQueueVisibility, Mode=OneWay}"
            Padding="14"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Strings.UploadQueueTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Border Padding="8,2" CornerRadius="6" Background="{ThemeResource GhostSuccessBgBrush}" Visibility="{x:Bind ViewModel.CloudSyncStateOkVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CloudSyncStatusText, Mode=OneWay}" Foreground="{ThemeResource GhostSuccessFgBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Padding="8,2" CornerRadius="6" Background="#26FFB900" Visibility="{x:Bind ViewModel.CloudSyncStateWarnVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CloudSyncStatusText, Mode=OneWay}" Foreground="#C87E00" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Padding="8,2" CornerRadius="6" Background="#26E81123" Visibility="{x:Bind ViewModel.CloudSyncStateErrorVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CloudSyncStatusText, Mode=OneWay}" Foreground="#D13438" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind ViewModel.UxStrings.LastSyncPrefix, Mode=OneWay}" />
                            <Run Text="{x:Bind ViewModel.LastSyncTimeText, Mode=OneWay}" />
                            <Run Text="  •  " />
                            <Run Text="{x:Bind ViewModel.CloudSyncStatusDetailText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsSyncing, Mode=OneWay}" Width="20" Height="20" />
                        <Button Content="{x:Bind ViewModel.Strings.PullCloudButton, Mode=OneWay}" Command="{x:Bind ViewModel.PullCloudArchiveCommand}" />
                        <Button Content="{x:Bind ViewModel.Strings.DownloadAllCloudButton, Mode=OneWay}" Command="{x:Bind ViewModel.DownloadAllCloudCommand}" />
                        <Button Content="{x:Bind ViewModel.Strings.RetryFailedButton, Mode=OneWay}" Command="{x:Bind ViewModel.RetryFailedCommand}" />
                        <Button Content="{x:Bind ViewModel.Strings.SyncNowButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SyncNowCommand}" />
                    </StackPanel>
                </Grid>

                <ProgressBar Value="{x:Bind ViewModel.SyncProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" />
            </StackPanel>
        </Border>

        <!-- Persistent Queue & Cloud Sync History (Hidden in Local-Only Mode) -->
        <Grid
            Grid.Row="3"
            Visibility="{x:Bind ViewModel.ActiveCloudQueueVisibility, Mode=OneWay}"
            ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ListView ItemsSource="{x:Bind ViewModel.UploadQueue}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:UploadQueueRow">
                            <Grid Padding="4,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind DetailText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{x:Bind UpdatedText}" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.Strings.ArchiveHistoryTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.HistoryEvents}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArchiveHistoryEventRow">
                                <Grid Padding="4,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind EventType}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{x:Bind Summary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
