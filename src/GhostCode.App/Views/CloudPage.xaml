<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GhostCode.App.Views.CloudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:GhostCode.App.ViewModels">

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Account & OAuth Connection SettingsCard -->
        <controls:SettingsCard
            Grid.Row="0"
            Header="{x:Bind ViewModel.Strings.CloudAccountTitle, Mode=OneWay}"
            Description="{x:Bind ViewModel.DriveConnectionStatusText, Mode=OneWay}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE753;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Content="{x:Bind ViewModel.Strings.ConfigureOAuthButton, Mode=OneWay}"
                    Click="ConfigureOAuth_Click" />
                <Button
                    Content="{x:Bind ViewModel.Strings.ConnectGoogleButton, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ConnectGoogleCommand}" />
                <Button
                    Content="{x:Bind ViewModel.Strings.DisconnectGoogleButton, Mode=OneWay}"
                    Command="{x:Bind ViewModel.DisconnectGoogleCommand}" />
            </StackPanel>
        </controls:SettingsCard>

        <!-- Sync Controls & Progress -->
        <Border Grid.Row="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.Strings.UploadQueueTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12">
                            <Run Text="Last Sync: " />
                            <Run Text="{x:Bind ViewModel.LastSyncTimeText, Mode=OneWay}" />
                            <Run Text="  •  " />
                            <Run Text="{x:Bind ViewModel.SyncProgressText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            Text="{x:Bind ViewModel.OAuthStageText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsSyncing, Mode=OneWay}" Width="24" Height="24" />
                        <Button Content="{x:Bind ViewModel.Strings.RetryFailedButton, Mode=OneWay}" Command="{x:Bind ViewModel.RetryFailedCommand}" />
                        <Button Content="{x:Bind ViewModel.Strings.SyncNowButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SyncNowCommand}" />
                    </StackPanel>
                </Grid>

                <ProgressBar Value="{x:Bind ViewModel.SyncProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" />
            </StackPanel>
        </Border>

        <!-- Persistent Queue Table -->
        <Border Grid.Row="2" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ListView ItemsSource="{x:Bind ViewModel.UploadQueue}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:UploadQueueRow">
                        <Grid Padding="4,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind DetailText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{x:Bind UpdatedText}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

    </Grid>
</Page>
