<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GhostCode.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GhostCode.App.ViewModels"
    Title="GhostCode">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchShortcut_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Single-Row Integrated Custom Title Bar -->
        <Grid
            x:Name="CustomTitleBarGrid"
            Grid.Row="0"
            Height="48"
            Padding="12,0,0,0"
            ColumnSpacing="12"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" x:Name="TitleBarRightInsetCol" MinWidth="138" />
            </Grid.ColumnDefinitions>

            <!-- Brand Icon + Title -->
            <StackPanel
                x:Name="TitleBarBrandPanel"
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Image
                    x:Name="TitleBarLogoImage"
                    Width="20"
                    Height="20"
                    Stretch="Uniform"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleBarTitleText"
                    Text="{x:Bind ViewModel.Strings.AppTitle, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Inline Global Search Inside Same Horizontal Row -->
            <AutoSuggestBox
                x:Name="GlobalSearchBox"
                Grid.Column="1"
                Height="32"
                MinWidth="140"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                QueryIcon="Find"
                PlaceholderText="{x:Bind ViewModel.Strings.GlobalSearchPlaceholder, Mode=OneWay}"
                TextChanged="GlobalSearchBox_TextChanged"
                SuggestionChosen="GlobalSearchBox_SuggestionChosen"
                QuerySubmitted="GlobalSearchBox_QuerySubmitted"
                KeyDown="GlobalSearchBox_KeyDown">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GlobalSearchSuggestion">
                        <StackPanel Padding="2,4" Spacing="1">
                            <TextBlock Text="{x:Bind DisplayTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <!-- Compact Adaptive Status Pills + Stats Flyout + Quick Actions (Single Title Bar Row) -->
            <StackPanel
                x:Name="TitleBarStatusPanel"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <Button
                    x:Name="TitleBarBrowserButton"
                    Padding="8,3"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="TitleBarBrowserButton_Click"
                    ToolTipService.ToolTip="{x:Bind ViewModel.CompactBrowserSummaryText, Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind ViewModel.TitleBarBrowserBadgeText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <Button
                    x:Name="TitleBarStatsButton"
                    Padding="8,3"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ToolTipService.ToolTip="{x:Bind ViewModel.TitleBarStatsTooltipText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE7BA;"
                            FontSize="11"
                            Foreground="#C42B1C"
                            Visibility="{x:Bind ViewModel.TitleBarStatsWarningVisibility, Mode=OneWay}"
                            VerticalAlignment="Center" />
                        <FontIcon
                            Glyph="&#xE8F1;"
                            FontSize="11"
                            Foreground="{ThemeResource GhostAccentBrush}"
                            Visibility="{x:Bind ViewModel.TitleBarStatsNormalVisibility, Mode=OneWay}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="TitleBarStatsWideTextBlock"
                            Text="{x:Bind ViewModel.TitleBarStatsWideText, Mode=OneWay}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="TitleBarStatsCompactTextBlock"
                            Visibility="Collapsed"
                            Text="{x:Bind ViewModel.TitleBarStatsCompactText, Mode=OneWay}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="TitleBarStatsFlyout">
                            <StackPanel Width="290" Spacing="10">
                                <TextBlock
                                    Text="{x:Bind ViewModel.TitleBarStatsFlyoutHeader, Mode=OneWay}"
                                    FontSize="14"
                                    FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Padding="10,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.StatsFlyoutSavedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.TotalVersions, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Padding="10,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.StatsFlyoutPendingLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.PendingUploads, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Padding="10,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.StatsFlyoutSyncedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SyncedUploads, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Padding="10,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.StatsFlyoutFailedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.FailedUploads, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Text="{x:Bind ViewModel.StatsFlyoutCloudStatusText, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{x:Bind ViewModel.Strings.SyncNowButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Padding="10,4" FontSize="12" Command="{x:Bind ViewModel.SyncNowCommand}" />
                                    <Button Content="{x:Bind ViewModel.Strings.DiagnosticButton, Mode=OneWay}" Padding="10,4" FontSize="12" Command="{x:Bind ViewModel.RunDiagnosticCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    x:Name="QuickActionsTitleBarButton"
                    Padding="8,2"
                    FontSize="11"
                    Content="{x:Bind ViewModel.ExpStrings.QuickActionsButton, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleQuickActionsCommand}" />
            </StackPanel>

            <!-- Reserved Native Caption Buttons Inset -->
            <Border Grid.Column="3" Background="Transparent" />
        </Grid>

        <NavigationView
            x:Name="RootNav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="204"
            CompactModeThresholdWidth="1020"
            SelectionChanged="RootNav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Dashboard" Content="{x:Bind ViewModel.Strings.NavDashboard, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Archive" Content="{x:Bind ViewModel.Strings.NavArchive, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Cloud" Content="{x:Bind ViewModel.Strings.NavCloud, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="DevTools" Content="{x:Bind ViewModel.UxStrings.NavDevTools, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Settings" Content="{x:Bind ViewModel.Strings.NavSettings, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Compact Floating Non-Shifting Status Notification Overlay (Auto-Dismiss Configurable) -->
        <Border
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            MaxWidth="460"
            Margin="0,0,18,16"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.InfoBarOpen, Mode=OneWay}"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            Canvas.ZIndex="10">
            <InfoBar
                x:Name="MainNotificationInfoBar"
                IsOpen="{x:Bind ViewModel.InfoBarOpen, Mode=TwoWay}"
                Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Content="{x:Bind ViewModel.InfoBarActionLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.InfoBarActionVisibility, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ExecuteFriendlyErrorActionCommand}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <Expander
                        Visibility="{x:Bind ViewModel.InfoBarHasDetailsVisibility, Mode=OneWay}"
                        Header="{x:Bind ViewModel.UxStrings.ErrorTechnicalDetailsHeader, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,4">
                        <StackPanel Spacing="6">
                            <TextBox
                                Text="{x:Bind ViewModel.InfoBarTechnicalDetails, Mode=OneWay}"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                FontFamily="Consolas"
                                FontSize="11"
                                MaxHeight="110" />
                            <Button
                                Content="{x:Bind ViewModel.UxStrings.ErrorCopyDetailsButton, Mode=OneWay}"
                                Command="{x:Bind ViewModel.CopyErrorDetailsCommand}" />
                        </StackPanel>
                    </Expander>
                </InfoBar.Content>
            </InfoBar>
        </Border>

        <!-- Lightweight Global Quick Actions Overlay (Ctrl+Shift+F9 or Title Bar Trigger) -->
        <Grid
            x:Name="QuickActionsOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Visibility="{x:Bind ViewModel.QuickActionsVisibility, Mode=OneWay}"
            Background="#88000000"
            Padding="32">
            <Border
                MaxWidth="640"
                MaxHeight="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.ExpStrings.QuickActionsTitle, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.GlobalHotkeyStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{x:Bind ViewModel.ExpStrings.QuickActionsClose, Mode=OneWay}" Command="{x:Bind ViewModel.CloseQuickActionsCommand}" />
                    </Grid>

                    <!-- Detected Problem + Cloud Sync Summary -->
                    <Border Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ActiveCode, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveTitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="8,3" CornerRadius="6" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind ViewModel.TitleBarDriveBadgeText, Mode=OneWay}" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Explicit Target Selector (never guesses silently when ambiguous) -->
                    <StackPanel Spacing="4">
                        <ComboBox
                            x:Name="QuickActionsTargetCombo"
                            HorizontalAlignment="Stretch"
                            Header="{x:Bind ViewModel.QuickActionsAmbiguityNote, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.QuickActionsCandidates}"
                            SelectedItem="{x:Bind ViewModel.SelectedQuickActionTarget, Mode=TwoWay}"
                            DisplayMemberPath="FileName" />
                        <TextBox
                            Text="{x:Bind ViewModel.QuickActionsLatestPreview, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            FontFamily="Consolas"
                            FontSize="12"
                            MaxHeight="160"
                            PlaceholderText="{x:Bind ViewModel.UxStrings.QuickActionsPreviewPlaceholder, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Quick Actions Row -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="{x:Bind ViewModel.ExpStrings.CopyLatestCode, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.HasQuickActionTarget, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CopyLatestProblemCodeCommand}" />
                        <Button Content="{x:Bind ViewModel.ExpStrings.CopySampleInput, Mode=OneWay}" Command="{x:Bind ViewModel.CopySampleInputCommand}" />
                        <Button Content="{x:Bind ViewModel.ExpStrings.OpenVersionHistory, Mode=OneWay}" Click="QuickActionsOpenHistory_Click" />
                        <Button
                            Content="{x:Bind ViewModel.ExpStrings.OpenInIde, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.HasQuickActionTarget, Mode=OneWay}"
                            Command="{x:Bind ViewModel.OpenQuickActionsInIdeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- IDM-Like Assisted Browser Extension Setup Wizard Overlay -->
        <Grid
            x:Name="BrowserSetupOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Visibility="{x:Bind ViewModel.BrowserSetupOverlayVisibility, Mode=OneWay}"
            Background="#88000000"
            Padding="32">
            <Border
                MaxWidth="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="22"
                CornerRadius="12"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.BrowserSetupTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.BrowserSetupStatusText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{x:Bind ViewModel.ExpStrings.QuickActionsClose, Mode=OneWay}" Command="{x:Bind ViewModel.CloseBrowserSetupCommand}" />
                    </Grid>

                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.BrowserSetupStep1, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.BrowserSetupStep2, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.BrowserSetupStep3, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.BrowserSetupStep4, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <TextBox
                        IsReadOnly="True"
                        FontFamily="Consolas"
                        FontSize="12"
                        Text="{x:Bind ViewModel.BrowserSetupExtensionPath, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind ViewModel.UxStrings.BrowserSetupOpenPageButton, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.OpenBrowserExtensionsPageCommand}" />
                        <Button Content="{x:Bind ViewModel.UxStrings.BrowserSetupOpenFolderButton, Mode=OneWay}" Command="{x:Bind ViewModel.OpenStagedExtensionFolderCommand}" />
                        <Button Content="{x:Bind ViewModel.UxStrings.BrowserSetupCopyPathButton, Mode=OneWay}" Command="{x:Bind ViewModel.CopyStagedExtensionPathCommand}" />
                        <Button Content="{x:Bind ViewModel.UxStrings.BrowserSetupCheckConnectionButton, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshDiscoveryCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
