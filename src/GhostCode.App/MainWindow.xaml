<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GhostCode.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GhostCode.App.ViewModels"
    Title="GhostCode">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchShortcut_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Single-Row Integrated Custom Title Bar -->
        <Grid
            x:Name="CustomTitleBarGrid"
            Grid.Row="0"
            Height="48"
            Padding="12,0,0,0"
            ColumnSpacing="12"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" x:Name="TitleBarRightInsetCol" MinWidth="138" />
            </Grid.ColumnDefinitions>

            <!-- Brand Icon + Title -->
            <StackPanel
                x:Name="TitleBarBrandPanel"
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Image
                    x:Name="TitleBarLogoImage"
                    Width="20"
                    Height="20"
                    Stretch="Uniform"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleBarTitleText"
                    Text="{x:Bind ViewModel.Strings.AppTitle, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Inline Global Search Inside Same Horizontal Row -->
            <AutoSuggestBox
                x:Name="GlobalSearchBox"
                Grid.Column="1"
                Height="32"
                MinWidth="180"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                QueryIcon="Find"
                PlaceholderText="{x:Bind ViewModel.Strings.GlobalSearchPlaceholder, Mode=OneWay}"
                TextChanged="GlobalSearchBox_TextChanged"
                SuggestionChosen="GlobalSearchBox_SuggestionChosen"
                QuerySubmitted="GlobalSearchBox_QuerySubmitted"
                KeyDown="GlobalSearchBox_KeyDown">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GlobalSearchSuggestion">
                        <StackPanel Padding="2,4" Spacing="1">
                            <TextBlock Text="{x:Bind DisplayTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <!-- Compact Status Pills (Same Horizontal Row) -->
            <StackPanel
                x:Name="TitleBarStatusPanel"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <Border
                    Padding="8,3"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <TextBlock
                        Text="{x:Bind ViewModel.TitleBarBrowserBadgeText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border
                    Padding="8,3"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <TextBlock
                        Text="{x:Bind ViewModel.TitleBarDriveBadgeText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- Reserved Native Caption Buttons Inset -->
            <Border Grid.Column="3" Background="Transparent" />
        </Grid>

        <!-- Global Status Notification Bar -->
        <InfoBar
            Grid.Row="1"
            Margin="16,4,16,0"
            IsOpen="{x:Bind ViewModel.InfoBarOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}" />

        <NavigationView
            x:Name="RootNav"
            Grid.Row="2"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="210"
            SelectionChanged="RootNav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Dashboard" Content="{x:Bind ViewModel.Strings.NavDashboard, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Archive" Content="{x:Bind ViewModel.Strings.NavArchive, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Cloud" Content="{x:Bind ViewModel.Strings.NavCloud, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Settings" Content="{x:Bind ViewModel.Strings.NavSettings, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
