{
  "manifest_version": 3,
  "name": "GhostCode Bridge (PTIT & Codeforces)",
  "version": "1.2.0",
  "description": "Authenticated active-tab context bridge for Code PTIT, Codeforces, VNOJ, LeetCode, and HackerRank.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://code.ptit.edu.vn/*",
    "*://*.codeforces.com/*",
    "*://oj.vnoi.info/*",
    "*://*.leetcode.com/*",
    "*://*.leetcode.cn/*",
    "*://*.hackerrank.com/*",
    "http://127.0.0.1:48123/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://code.ptit.edu.vn/*",
        "*://*.codeforces.com/*",
        "*://oj.vnoi.info/*",
        "*://*.leetcode.com/*",
        "*://*.leetcode.cn/*",
        "*://*.hackerrank.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
